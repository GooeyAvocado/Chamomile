{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🐳 Build & Compose Up",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "./generate-build-env.ps1; docker compose up --build -d"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "dotnet",
            "task": "build",
            "group": "build",
            "problemMatcher": [],
            "label": "build"
        }
    ]
}